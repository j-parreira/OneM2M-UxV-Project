# Large data files (>10 MB individual file limit)
# Current dataset is small (<2 MB total) — tracked in git for reproducibility
# Revisit if individual files exceed 10 MB
# Preserve directory markers
!data/raw/.gitkeep
!data/processed/.gitkeep

# Environment / secrets
# .env is committed intentionally (no credentials — only IPs/ports for lab setup)
local.properties
secrets.json

# OS
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

