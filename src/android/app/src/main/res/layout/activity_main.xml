<?xml version="1.0" encoding="utf-8"?>
<com.dji.sdk.duvops.app.MainContent
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:orientation="vertical"
    tools:context=".app.MainActivity">

    <ProgressBar
        android:id="@+id/progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/startup_scroll_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/startup_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progress_indicator"
                style="@android:style/Widget.ProgressBar.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardando ligação..."
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/text_product_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produto desconhecido"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/text_model_available"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/edittext_bridge_ip"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_bluetooth"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/checkbox_firmware"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_registerApp"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/btn_default"
                android:text="Registar App"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_registerAppForLDM"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@android:drawable/btn_default"
                android:text="Registar (LDM)"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_open"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="ABRIR DUVOPS"
                android:textStyle="bold"
                android:textSize="16sp"
                android:theme="@style/ThemeOverlay.AppCompat.Dark"
                android:backgroundTint="@android:color/holo_blue_dark"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/text_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="SDK Version"
                android:textColor="#666666"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</com.dji.sdk.duvops.app.MainContent>