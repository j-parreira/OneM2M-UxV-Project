# src/frontend/.env — conexão ao ACME CSE e callbacks de notificação
# NÃO commitar este ficheiro (está em .gitignore)

# IP para o Streamlit ligar ao CSE Docker.
# Usar 127.0.0.1 (loopback) quando Streamlit corre na mesma máquina que o Docker —
# loopback bypassa o Windows Firewall (Public profile bloqueia ligações ao IP LAN
# mesmo vindo da mesma máquina).
CSE_HOST=127.0.0.1
CSE_HTTP_PORT=8080
CSE_WS_PORT=8180
CSE_MQTT_PORT=1883
CSE_COAP_PORT=5683

# IP desta máquina (Streamlit) — o CSE Docker faz POST para aqui nas notificações HTTP
# Deve ser o IP LAN real, NÃO 127.0.0.1 (Docker não alcança loopback do host)
CALLBACK_HOST=192.168.1.71
CALLBACK_HTTP_PORT=8090
CALLBACK_COAP_PORT=5685

# Host do broker MQTT conforme visto de DENTRO do container Docker CSE
# "mosquitto" = nome do serviço no docker-compose.yml (resolução via DNS Docker)
MQTT_BROKER_POA_HOST=mosquitto

# Directório para CSV de resultados (relativo a src/frontend/)
DATA_RAW_DIR=../../data/raw
