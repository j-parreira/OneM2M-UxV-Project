# src/frontend/.env -- UxV Benchmark configuration (committed to git)
# Values below match the current lab setup (dev machine LAN IP: 192.168.1.71).

# IP para o Streamlit ligar ao CSE Docker.
# 127.0.0.1 (loopback) quando Streamlit e Docker correm na mesma maquina --
# loopback bypassa o Windows Firewall (bloqueia ligacoes ao IP LAN publico).
CSE_HOST=127.0.0.1
CSE_HTTP_PORT=8080
CSE_WS_PORT=8180
CSE_MQTT_PORT=1883
CSE_COAP_PORT=5683

# IP desta maquina na LAN WiFi -- o CSE Docker usa este IP para notificacoes.
# Nao usar 127.0.0.1: o container Docker nao alcanca o loopback do host.
CALLBACK_HOST=192.168.1.71
CALLBACK_HTTP_PORT=8090
CALLBACK_COAP_PORT=5685

# Host do broker MQTT visto de DENTRO do container Docker CSE.
# mosquitto = nome do servico no docker-compose.yml (DNS Docker interno).
MQTT_BROKER_POA_HOST=mosquitto

# Directorio para CSV de resultados (relativo a src/frontend/).
DATA_RAW_DIR=../../data/raw