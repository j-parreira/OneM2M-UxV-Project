# .env.example -- UxV Benchmark Streamlit Dashboard
#
# Copy to .env and fill in your LAN IP addresses.
# .env is git-ignored -- never commit real values.
#
# All defaults match local Docker Desktop. For a real LAN deployment,
# set CSE_HOST and CALLBACK_HOST to the dev machine WiFi LAN IP.

# -- ACME CSE connection ---------------------------------------------------
CSE_HOST=127.0.0.1          # LAN IP of the machine running docker compose up
CSE_HTTP_PORT=8080           # HTTP binding (acme.ini: httpPort)
CSE_MQTT_PORT=1883           # MQTT broker port (Mosquitto)
CSE_WS_PORT=8180             # WebSocket binding (acme.ini: [websocket] port)
CSE_COAP_PORT=5683           # CoAP binding (acme.ini: [coap] port, UDP)

# -- Data storage ----------------------------------------------------------
DATA_RAW_DIR=../../data/raw  # Relative to src/frontend/

# -- HTTP / CoAP callback servers ------------------------------------------
# The CSE Docker container POSTs/CONs notifications to this machine.
# Must be a LAN IP -- 127.0.0.1 will NOT work from inside Docker.
CALLBACK_HOST=127.0.0.1     # This machine WiFi LAN IP (e.g. 192.168.1.100)
CALLBACK_HTTP_PORT=8090      # Embedded HTTP callback server (http_client.py)
CALLBACK_COAP_PORT=5684      # Embedded CoAP callback server (coap_client.py)

# -- MQTT poa host (notification delivery address used by the CSE) ----------
# Must be reachable FROM INSIDE the CSE Docker container, not from the host.
# Default: mosquitto = Docker Compose service name (correct for Docker setup).
# Do NOT use 127.0.0.1: the CSE container loopback is NOT the host Mosquitto.
MQTT_BROKER_POA_HOST=mosquitto
