# .env.example — copy to .env and fill in values.
# This file is committed; .env is git-ignored (never commit credentials or IPs).

# IP of the dev machine running Docker (LAN IP — NOT 127.0.0.1 when Android must reach the CSE).
CSE_HOST=192.168.1.100

CSE_HTTP_PORT=8080
CSE_MQTT_PORT=1883
CSE_WS_PORT=8180
CSE_COAP_PORT=5683

# Directory where benchmark CSVs are written (relative to src/frontend/).
DATA_RAW_DIR=../../data/raw

# For HTTP and CoAP protocol clients: the IP of THIS machine as reachable by the CSE container.
# On Docker Desktop for Windows, the host is reachable at the LAN IP (not 127.0.0.1).
# The CSE container POSTs/CONFIRMs to these ports to deliver push notifications.
CALLBACK_HOST=192.168.1.100
CALLBACK_HTTP_PORT=8090
CALLBACK_COAP_PORT=5684
